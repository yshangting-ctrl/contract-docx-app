PORT=4000
NODE_ENV=production

# 改成你的正式访问地址。启用 HTTPS 后用 https://你的域名
CLIENT_ORIGIN=https://example.com

# 推荐生产环境创建 MongoDB 用户后使用带账号密码的 URI。
# 无认证本机数据库示例：
# MONGODB_URI=mongodb://127.0.0.1:27017/telecom_contracts
# 带认证示例：
MONGODB_URI=mongodb://contract_app:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:27017/telecom_contracts?authSource=telecom_contracts

# 查公司资料优先使用风鸟 API。也兼容变量名 FN_API_KEY。
RISKBIRD_API_KEY=

# 企业字号、邮编等自动查询使用；没有则相关自动能力不可用，但生成 Word 不受影响。
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Pro/zai-org/GLM-5.1

# 第三方查询接口超时，单位毫秒。
EXTERNAL_API_TIMEOUT_MS=15000
